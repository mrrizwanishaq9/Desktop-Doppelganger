    # ========================================================
    # MONITORS
    # ========================================================

    def refresh_monitors(self):

        try:

            with mss.mss() as sct:

                count = len(sct.monitors) - 1

            if count < 1:
                count = 1

            values = list(
                range(1, count + 1)
            )

            self.monitor_combo["values"] = values

            if self.monitor_var.get() not in values:

                self.monitor_var.set(
                    values[0]
                )

            self.write_log(
                f"Detected {count} monitor(s)."
            )

        except Exception as error:

            self.write_log(
                f"Monitor error: {error}"
            )

    # ========================================================
    # START CAPTURE
    # ========================================================

    def start_capture(self):

        if self.running:
            return

        self.running = True

        self.stop_event.clear()

        self.session_start = time.time()

        self.status_label.config(
            text="● ONLINE",
            fg="#65e6a6"
        )

        self.capture_thread = threading.Thread(
            target=self.capture_loop,
            daemon=True
        )

        self.capture_thread.start()

        self.write_log(
            "Capture engine started."
        )

    # ========================================================
    # STOP CAPTURE
    # ========================================================

    def stop_capture(self):

        self.running = False

        self.stop_event.set()

        if self.recording:

            self.stop_recording()

        self.status_label.config(
            text="● OFFLINE",
            fg="#ff6474"
        )

        self.write_log(
            "Capture engine stopped."
        )

    # ========================================================
    # CAPTURE LOOP
    # ========================================================

    def capture_loop(self):

        try:

            with mss.mss() as sct:

                while (
                    self.running
                    and not self.stop_event.is_set()
                ):

                    start_time = time.perf_counter()

                    monitor_index = int(
                        self.monitor_var.get()
                    )

                    if (
                        monitor_index < 1
                        or monitor_index >= len(sct.monitors)
                    ):
                        monitor_index = 1

                    monitor = sct.monitors[
                        monitor_index
                    ]

                    raw = np.array(
                        sct.grab(monitor)
                    )

                    frame = cv2.cvtColor(
                        raw,
                        cv2.COLOR_BGRA2BGR
                    )

                    # PERFORMANCE
                    frame = self.optimize_frame(
                        frame
                    )

                    # FX
                    frame = self.apply_effect(
                        frame
                    )

                    # GRID
                    if self.grid_var.get():

                        frame = self.draw_grid(
                            frame
                        )

                    # FPS
                    now = time.time()

                    elapsed = max(
                        now - self.last_frame_time,
                        0.0001
                    )

                    self.frame_time = (
                        elapsed * 1000
                    )

                    instant_fps = (
                        1.0 / elapsed
                    )

                    if self.fps <= 0:

                        self.fps = instant_fps

                    else:

                        self.fps = (
                            self.fps * 0.85
                            + instant_fps * 0.15
                        )

                    self.last_frame_time = now

                    self.frame_counter += 1

                    # RECORDING
                    if (
                        self.recording
                        and not self.record_paused
                    ):

                        self.write_record_frame(
                            frame
                        )

                    # SAVE FRAME
                    with self.frame_lock:

                        self.current_frame = (
                            frame.copy()
                        )

                    # AUTOMATION
                    self.auto_screenshot(frame)

                    self.run_director()

                    # TARGET FPS
                    target = max(
                        5,
                        min(
                            60,
                            int(
                                self.target_fps_var.get()
                            )
                        )
                    )

                    processing = (
                        time.perf_counter()
                        - start_time
                    )

                    sleep_time = max(
                        0,
                        (1 / target)
                        - processing
                    )

                    time.sleep(
                        sleep_time
                    )

        except Exception as error:

            self.write_log(
                f"Capture error: {error}"
            )

            self.root.after(
                0,
                self.recovery_mode
            )

    # ========================================================
    # SMART OPTIMIZATION
    # ========================================================

    def optimize_frame(self, frame):

        height, width = frame.shape[:2]

        mode = self.mode_var.get()

        if mode == "Turbo":

            scale = 0.60

        elif mode == "Ultra":

            scale = 1.0

        else:

            scale = 0.80

        # SAFE MODE
        if self.safe_mode_var.get():

            scale = min(
                scale,
                0.55
            )

        # AUTO FPS CONTROL
        if self.auto_optimize_var.get():

            if self.fps < 15:

                scale *= 0.65

            elif self.fps < 25:

                scale *= 0.80

        scale = max(
            0.40,
            min(1.0, scale)
        )

        if scale < 0.98:

            new_width = max(
                320,
                int(width * scale)
            )

            new_height = max(
                180,
                int(height * scale)
            )

            frame = cv2.resize(
                frame,
                (
                    new_width,
                    new_height
                ),
                interpolation=cv2.INTER_AREA
            )

        return frame

    # ========================================================
    # EFFECT ENGINE
    # ========================================================

    def apply_effect(self, frame):

        effect = self.effect_var.get()

        try:

            if effect == "None":

                result = frame

            elif effect == "Infinite Mirror":

                result = self.fx_mirror(
                    frame
                )

            elif effect == "Portal":

                result = self.fx_portal(
                    frame
                )

            elif effect == "Tunnel":

                result = self.fx_tunnel(
                    frame
                )

            elif effect == "Kaleidoscope":

                result = self.fx_kaleidoscope(
                    frame
                )

            elif effect == "Spiral":

                result = self.fx_spiral(
                    frame
                )

            elif effect == "Wave":

                result = self.fx_wave(
                    frame
                )

            elif effect == "Ripple":

                result = self.fx_ripple(
                    frame
                )

            elif effect == "VHS":

                result = self.fx_vhs(
                    frame
                )

            elif effect == "CRT":

                result = self.fx_crt(
                    frame
                )

            elif effect == "Glitch":

                result = self.fx_glitch(
                    frame
                )

            elif effect == "Matrix":

                result = self.fx_matrix(
                    frame
                )

            elif effect == "Thermal":

                result = self.fx_thermal(
                    frame
                )

            elif effect == "Blueprint":

                result = self.fx_blueprint(
                    frame
                )

            elif effect == "Neon Edge":

                result = self.fx_neon(
                    frame
                )

            elif effect == "Ghost Echo":

                result = self.fx_ghost(
                    frame
                )

            elif effect == "Chromatic":

                result = self.fx_chromatic(
                    frame
                )

            elif effect == "Fisheye":

                result = self.fx_fisheye(
                    frame
                )

            elif effect == "Pixelate":

                result = self.fx_pixelate(
                    frame
                )

            elif effect == "Invert":

                result = cv2.bitwise_not(
                    frame
                )

            elif effect == "Edge Map":

                gray = cv2.cvtColor(
                    frame,
                    cv2.COLOR_BGR2GRAY
                )

                edges = cv2.Canny(
                    gray,
                    70,
                    150
                )

                result = cv2.cvtColor(
                    edges,
                    cv2.COLOR_GRAY2BGR
                )

            elif effect == "Random FX":

                result = self.fx_random(
                    frame
                )

            else:

                result = frame

            return self.force_size(
                result,
                frame.shape[1],
                frame.shape[0]
            )

        except Exception as error:

            self.write_log(
                f"FX fallback: {error}"
            )

            return frame

    # ========================================================
    # RESIZE
    # ========================================================

    def force_size(
        self,
        frame,
        width,
        height
    ):

        if frame is None:

            return np.zeros(
                (
                    height,
                    width,
                    3
                ),
                dtype=np.uint8
            )

        if (
            frame.shape[1] != width
            or frame.shape[0] != height
        ):

            frame = cv2.resize(
                frame,
                (
                    width,
                    height
                )
            )

        return frame

    # ========================================================
    # MIRROR
    # ========================================================

    def fx_mirror(self, frame):

        result = frame.copy()

        depth = max(
            1,
            min(
                9,
                int(
                    self.recursion_var.get()
                )
            )
        )

        intensity = self.intensity_var.get()

        for i in range(depth):

            scale = max(
                0.25,
                self.zoom_var.get()
                ** (i + 1)
            )

            small = cv2.resize(
                frame,
                None,
                fx=scale,
                fy=scale,
                interpolation=cv2.INTER_AREA
            )

            small = cv2.flip(
                small,
                1 if i % 2 == 0 else 0
            )

            small = self.rotate_image(
                small,
                self.rotation_var.get()
                * (i + 1)
                / depth
            )

            result = self.overlay_center(
                result,
                small,
                min(
                    0.55,
                    0.18 + intensity * 0.35
                )
            )

        return result

    # ========================================================
    # PORTAL
    # ========================================================

    def fx_portal(self, frame):

        result = frame.copy()

        depth = max(
            3,
            min(
                9,
                int(
                    self.recursion_var.get()
                ) + 2
            )
        )

        for i in range(
            depth,
            0,
            -1
        ):

            scale = (
                0.25
                + (i / depth) * 0.65
            )

            small = cv2.resize(
                frame,
                None,
                fx=scale,
                fy=scale
            )

            if i % 2:

                small = cv2.flip(
                    small,
                    1
                )

            small = self.rotate_image(
                small,
                self.rotation_var.get()
                * i
            )

            result = self.overlay_center(
                result,
                small,
                0.18
                + self.intensity_var.get()
                * 0.15
            )

        return result

    # ========================================================
    # TUNNEL
    # ========================================================

    def fx_tunnel(self, frame):

        result = np.zeros_like(
            frame
        )

        depth = max(
            3,
            min(
                12,
                self.recursion_var.get() + 4
            )
        )

        for i in range(
            depth,
            0,
            -1
        ):

            scale = (
                0.20
                + (i / depth) * 0.70
            )

            small = cv2.resize(
                frame,
                None,
                fx=scale,
                fy=scale
            )

            if i % 2:

                small = cv2.flip(
                    small,
                    1
                )

            result = self.overlay_center(
                result,
                small,
                0.12
                + self.intensity_var.get()
                * 0.08
            )

        return cv2.addWeighted(
            frame,
            0.35,
            result,
            0.65,
            0
        )

    # ========================================================
    # KALEIDOSCOPE
    # ========================================================

    def fx_kaleidoscope(self, frame):

        h, w = frame.shape[:2]

        size = min(
            h,
            w
        )

        y = (
            h - size
        ) // 2

        x = (
            w - size
        ) // 2

        square = frame[
            y:y + size,
            x:x + size
        ]

        square = cv2.resize(
            square,
            (
                min(h, w),
                min(h, w)
            )
        )

        a = square
        b = cv2.flip(
            square,
            1
        )

        c = cv2.flip(
            square,
            0
        )

        d = cv2.flip(
            square,
            -1
        )

        top = np.hstack(
            (a, b)
        )

        bottom = np.hstack(
            (c, d)
        )

        result = np.vstack(
            (top, bottom)
        )

        return cv2.resize(
            result,
            (
                w,
                h
            )
        )

    # ========================================================
    # SPIRAL
    # ========================================================

    def fx_spiral(self, frame):

        result = np.zeros_like(
            frame
        )

        depth = max(
            2,
            min(
                8,
                self.recursion_var.get()
            )
        )

        for i in range(depth):

            scale = (
                0.55
                + i * 0.05
            )

            small = cv2.resize(
                frame,
                None,
                fx=scale,
                fy=scale
            )

            angle = (
                self.rotation_var.get()
                + i
                * (
                    10
                    + 15
                    * self.intensity_var.get()
                )
            )

            small = self.rotate_image(
                small,
                angle
            )

            result = self.overlay_center(
                result,
                small,
                0.20
            )

        return cv2.addWeighted(
            frame,
            0.35,
            result,
            0.65,
            0
        )

    # ========================================================
    # WAVE
    # ========================================================

    def fx_wave(self, frame):

        return self.distort(
            frame,
            ripple=False
        )

    # ========================================================
    # RIPPLE
    # ========================================================

    def fx_ripple(self, frame):

        return self.distort(
            frame,
            ripple=True
        )

    # ========================================================
    # DISTORT
    # ========================================================

    def distort(
        self,
        frame,
        ripple=False
    ):

        h, w = frame.shape[:2]

        y, x = np.indices(
            (h, w),
            dtype=np.float32
        )

        strength = (
            5
            + 22
            * self.intensity_var.get()
        )

        if ripple:

            cx = w / 2
            cy = h / 2

            distance = np.sqrt(
                (x - cx) ** 2
                + (y - cy) ** 2
            )

            shift = (
                np.sin(
                    distance / 20
                )
                * strength
            )

            map_x = x + shift
            map_y = y + shift

        else:

            map_x = (
                x
                + np.sin(y / 25)
                * strength
            )

            map_y = (
                y
                + np.sin(x / 35)
                * strength
            )

        return cv2.remap(
            frame,
            map_x,
            map_y,
            cv2.INTER_LINEAR,
            borderMode=cv2.BORDER_REFLECT
        )

    # ========================================================
    # VHS
    # ========================================================

    def fx_vhs(self, frame):

        result = frame.copy()

        h, w = result.shape[:2]

        shift = max(
            1,
            int(
                3
                + 12
                * self.intensity_var.get()
            )
        )

        result[:, shift:] = (
            result[:, :-shift]
        )

        noise = np.random.randint(
            0,
            22,
            (
                h,
                w,
                1
            ),
            dtype=np.uint8
        )

        noise = np.repeat(
            noise,
            3,
            axis=2
        )

        result = cv2.add(
            result,
            noise
        )

        for y in range(
            0,
            h,
            4
        ):

            result[y:y+1] = (
                result[y:y+1]
                // 2
            )

        return result

    # ========================================================
    # CRT
    # ========================================================

    def fx_crt(self, frame):

        result = frame.copy()

        for y in range(
            0,
            result.shape[0],
            3
        ):

            result[y] = (
                result[y]
                * 0.60
            ).astype(
                np.uint8
            )

        return result

    # ========================================================
    # GLITCH
    # ========================================================

    def fx_glitch(self, frame):

        result = frame.copy()

        h, w = result.shape[:2]

        blocks = int(
            3
            + self.intensity_var.get()
            * 12
        )

        for _ in range(
            blocks
        ):

            if h < 10:
                break

            y = random.randint(
                0,
                max(0, h - 5)
            )

            block_height = random.randint(
                2,
                max(
                    3,
                    min(
                        30,
                        h // 8
                    )
                )
            )

            shift = random.randint(
                -max(5, w // 20),
                max(5, w // 20)
            )

            result[
                y:y + block_height
            ] = np.roll(
                result[
                    y:y + block_height
                ],
                shift,
                axis=1
            )

        return result

    # ========================================================
    # MATRIX
    # ========================================================

    def fx_matrix(self, frame):

        gray = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2GRAY
        )

        gray = cv2.resize(
            gray,
            None,
            fx=0.25,
            fy=0.25
        )

        gray = cv2.GaussianBlur(
            gray,
            (0, 0),
            2
        )

        gray = cv2.resize(
            gray,
            (
                frame.shape[1],
                frame.shape[0]
            )
        )

        result = np.zeros_like(
            frame
        )

        result[:, :, 1] = gray

        return result

    # ========================================================
    # THERMAL
    # ========================================================

    def fx_thermal(self, frame):

        gray = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2GRAY
        )

        return cv2.applyColorMap(
            gray,
            cv2.COLORMAP_INFERNO
        )

    # ========================================================
    # BLUEPRINT
    # ========================================================

    def fx_blueprint(self, frame):

        gray = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2GRAY
        )

        edges = cv2.Canny(
            gray,
            50,
            140
        )

        result = np.zeros_like(
            frame
        )

        result[:, :, 0] = edges

        result[:, :, 1] = (
            edges // 2
        )

        result[:, :, 2] = (
            edges // 5
        )

        return result

    # ========================================================
    # NEON
    # ========================================================

    def fx_neon(self, frame):

        gray = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2GRAY
        )

        edges = cv2.Canny(
            gray,
            60,
            150
        )

        glow = cv2.GaussianBlur(
            edges,
            (0, 0),
            5
        )

        result = cv2.cvtColor(
            glow,
            cv2.COLOR_GRAY2BGR
        )

        result[:, :, 1] = np.maximum(
            result[:, :, 1] // 2,
            edges
        )

        result[:, :, 2] = edges

        return cv2.addWeighted(
            frame,
            0.25,
            result,
            0.95,
            0
        )

    # ========================================================
    # GHOST
    # ========================================================

    def fx_ghost(self, frame):

        shifted = np.roll(
            frame,
            8,
            axis=1
        )

        return cv2.addWeighted(
            frame,
            0.70,
            shifted,
            0.30,
            0
        )

    # ========================================================
    # CHROMATIC
    # ========================================================

    def fx_chromatic(self, frame):

        blue, green, red = cv2.split(
            frame
        )

        shift = int(
            2
            + 8
            * self.intensity_var.get()
        )

        red = np.roll(
            red,
            shift,
            axis=1
        )

        blue = np.roll(
            blue,
            -shift,
            axis=1
        )

        return cv2.merge(
            (
                blue,
                green,
                red
            )
        )

    # ========================================================
    # FISHEYE
    # ========================================================

    def fx_fisheye(self, frame):

        h, w = frame.shape[:2]

        y, x = np.indices(
            (h, w),
            dtype=np.float32
        )

        cx = w / 2
        cy = h / 2

        dx = x - cx
        dy = y - cy

        distance = np.sqrt(
            dx * dx
            + dy * dy
        )

        maximum = np.sqrt(
            cx * cx
            + cy * cy
        )

        factor = (
            1
            + 0.28
            * self.intensity_var.get()
            * (
                distance
                / maximum
            ) ** 2
        )

        map_x = (
            cx
            + dx / factor
        )

        map_y = (
            cy
            + dy / factor
        )

        return cv2.remap(
            frame,
            map_x,
            map_y,
            cv2.INTER_LINEAR,
            borderMode=cv2.BORDER_REFLECT
        )

    # ========================================================
    # PIXELATE
    # ========================================================

    def fx_pixelate(self, frame):

        h, w = frame.shape[:2]

        block = max(
            4,
            int(
                4
                + 20
                * self.intensity_var.get()
            )
        )

        small = cv2.resize(
            frame,
            (
                max(
                    1,
                    w // block
                ),
                max(
                    1,
                    h // block
                )
            ),
            interpolation=cv2.INTER_AREA
        )

        return cv2.resize(
            small,
            (
                w,
                h
            ),
            interpolation=cv2.INTER_NEAREST
        )

    # ========================================================
    # RANDOM
    # ========================================================

    def fx_random(self, frame):

        effects = [
            "Infinite Mirror",
            "Portal",
            "Tunnel",
            "Kaleidoscope",
            "Glitch",
            "CRT",
            "Wave",
            "Chromatic",
            "Neon Edge"
        ]

        selected = random.choice(
            effects
        )

        old = self.effect_var.get()

        self.effect_var.set(
            selected
        )

        result = self.apply_effect(
            frame
        )

        self.effect_var.set(
            old
        )

        return result

    # ========================================================
    # ROTATE
    # ========================================================

    def rotate_image(
        self,
        frame,
        angle
    ):

        if abs(angle) < 0.1:

            return frame

        h, w = frame.shape[:2]

        matrix = cv2.getRotationMatrix2D(
            (
                w // 2,
                h // 2
            ),
            angle,
            1.0
        )

        return cv2.warpAffine(
            frame,
            matrix,
            (
                w,
                h
            ),
            borderMode=cv2.BORDER_REFLECT
        )

    # ========================================================
    # CENTER OVERLAY
    # ========================================================

    def overlay_center(
        self,
        base,
        layer,
        alpha
    ):

        h, w = base.shape[:2]

        max_width = max(
            1,
            int(
                w
                * self.zoom_var.get()
            )
        )

        max_height = max(
            1,
            int(
                h
                * self.zoom_var.get()
            )
        )

        layer = cv2.resize(
            layer,
            (
                max_width,
                max_height
            )
        )

        lh, lw = layer.shape[:2]

        x = (
            w - lw
        ) // 2

        y = (
            h - lh
        ) // 2

        x1 = max(
            0,
            x
        )

        y1 = max(
            0,
            y
        )

        x2 = min(
            w,
            x + lw
        )

        y2 = min(
            h,
            y + lh
        )

        if x2 <= x1 or y2 <= y1:

            return base

        crop = layer[
            y1-y:y2-y,
            x1-x:x2-x
        ]

        base[
            y1:y2,
            x1:x2
        ] = cv2.addWeighted(
            base[
                y1:y2,
                x1:x2
            ],
            1 - alpha,
            crop,
            alpha,
            0
        )

        return base

    # ========================================================
    # GRID
    # ========================================================

    def draw_grid(self, frame):

        result = frame.copy()

        h, w = result.shape[:2]

        step = max(
            40,
            min(
                w,
                h
            ) // 10
        )

        for x in range(
            0,
            w,
            step
        ):

            cv2.line(
                result,
                (x, 0),
                (x, h),
                (90, 160, 190),
                1
            )

        for y in range(
            0,
            h,
            step
        ):

            cv2.line(
                result,
                (0, y),
                (w, y),
                (90, 160, 190),
                1
            )

        cv2.putText(
            result,
            f"{w} x {h}",
            (15, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (180, 220, 240),
            2
        )

        return result

    # ========================================================
    # RECORDING
    # ========================================================

    def toggle_recording(self):

        if self.recording:

            self.stop_recording()

        else:

            if not self.running:

                self.start_capture()

                self.root.after(
                    500,
                    self.start_recording
                )

            else:

                self.start_recording()

    # ========================================================
    # START RECORDING
    # ========================================================

    def start_recording(self):

        if self.recording:

            return

        with self.frame_lock:

            frame = (
                None
                if self.current_frame is None
                else self.current_frame.copy()
            )

        if frame is None:

            self.write_log(
                "No frame available."
            )

            return

        height, width = frame.shape[:2]

        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        path = (
            RECORDING_DIR
            / f"Doppelganger_{timestamp}.mp4"
        )

        fourcc = cv2.VideoWriter_fourcc(
            *"mp4v"
        )

        writer = cv2.VideoWriter(
            str(path),
            fourcc,
            int(
                self.target_fps_var.get()
            ),
            (
                width,
                height
            )
        )

        if not writer.isOpened():

            writer.release()

            path = (
                RECORDING_DIR
                / f"Doppelganger_{timestamp}.avi"
            )

            fourcc = cv2.VideoWriter_fourcc(
                *"XVID"
            )

            writer = cv2.VideoWriter(
                str(path),
                fourcc,
                int(
                    self.target_fps_var.get()
                ),
                (
                    width,
                    height
                )
            )

        if not writer.isOpened():

            self.write_log(
                "Recording codec unavailable."
            )

            return

        self.writer = writer

        self.recording_path = path

        self.recording = True

        self.record_paused = False

        self.recording_frames = 0

        self.write_log(
            f"Recording started: {path.name}"
        )

    # ========================================================
    # STOP RECORDING
    # ========================================================

    def stop_recording(self):

        self.recording = False

        self.record_paused = False

        if self.writer is not None:

            self.writer.release()

            self.writer = None

        if self.recording_path:

            self.write_log(
                f"Recording saved: "
                f"{self.recording_path.name}"
            )

        self.recording_path = None

    # ========================================================
    # PAUSE
    # ========================================================

    def pause_recording(self):

        if not self.recording:

            return

        self.record_paused = (
            not self.record_paused
        )

        if self.record_paused:

            self.write_log(
                "Recording paused."
            )

        else:

            self.write_log(
                "Recording resumed."
            )

    # ========================================================
    # WRITE RECORD FRAME
    # ========================================================

    def write_record_frame(
        self,
        frame
    ):

        try:

            if self.writer is None:

                return

            self.writer.write(
                frame
            )

            self.recording_frames += 1

        except Exception as error:

            self.dropped_frames += 1

            self.write_log(
                f"Recording frame error: {error}"
            )

    # ========================================================
    # SCREENSHOT
    # ========================================================

    def take_screenshot(self):

        with self.frame_lock:

            frame = (
                None
                if self.current_frame is None
                else self.current_frame.copy()
            )

        if frame is None:

            self.write_log(
                "No frame available."
            )

            return

        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S_%f"
        )[:-3]

        path = (
            SCREENSHOT_DIR
            / f"Screenshot_{timestamp}.png"
        )

        try:

            cv2.imwrite(
                str(path),
                frame
            )

            self.write_log(
                f"Screenshot saved: {path.name}"
            )

        except Exception as error:

            self.write_log(
                f"Screenshot error: {error}"
            )

    # ========================================================
    # AUTOMATIC SCREENSHOT
    # ========================================================

    def auto_screenshot(
        self,
        frame
    ):

        if not self.auto_screenshot_var.get():

            return

        interval = max(
            2,
            int(
                self.screenshot_interval_var.get()
            )
        )

        now = time.time()

        if (
            now
            - self.last_screenshot
            >= interval
        ):

            timestamp = datetime.now().strftime(
                "%Y%m%d_%H%M%S"
            )

            path = (
                SCREENSHOT_DIR
                / f"Auto_{timestamp}.png"
            )

            try:

                cv2.imwrite(
                    str(path),
                    frame
                )

                self.last_screenshot = now

            except Exception:

                pass

    # ========================================================
    # DIRECTOR
    # ========================================================

    def toggle_director(self):

        self.director_var.set(
            not self.director_var.get()
        )

        self.director_enabled = (
            self.director_var.get()
        )

        self.director_timer = time.time()

        self.write_log(
            "Director Mode "
            + (
                "enabled."
                if self.director_enabled
                else "disabled."
            )
        )

    # ========================================================
    # DIRECTOR ENGINE
    # ========================================================

    def run_director(self):

        if not self.director_var.get():

            return

        name, duration = (
            self.director_sequence[
                self.director_index
            ]
        )

        if (
            time.time()
            - self.director_timer
            >= duration
        ):

            self.director_index = (
                self.director_index + 1
            ) % len(
                self.director_sequence
            )

            self.effect_var.set(
                self.director_sequence[
                    self.director_index
                ][0]
            )

            self.director_timer = (
                time.time()
            )

    # ========================================================
    # RANDOM EFFECT
    # ========================================================

    def random_effect(self):

        values = list(
            self.effect_combo["values"]
        )

        if values:

            selected = random.choice(
                values
            )

            self.effect_var.set(
                selected
            )

            self.write_log(
                f"Random FX: {selected}"
            )

    # ========================================================
    # RESET
    # ========================================================

    def reset_effects(self):

        self.effect_var.set(
            "Infinite Mirror"
        )

        self.recursion_var.set(
            4
        )

        self.zoom_var.set(
            0.82
        )

        self.intensity_var.set(
            0.65
        )

        self.rotation_var.set(
            0
        )

        self.mode_var.set(
            "Balanced"
        )

        self.safe_mode_var.set(
            False
        )

        self.write_log(
            "FX settings reset."
        )

    # ========================================================
    # SAFE MODE
    # ========================================================

    def enable_safe_mode(self):

        self.safe_mode_var.set(
            True
        )

        self.mode_var.set(
            "Turbo"
        )

        self.recursion_var.set(
            min(
                self.recursion_var.get(),
                3
            )
        )

        self.write_log(
            "Safe Mode enabled."
        )

    # ========================================================
    # EMERGENCY
    # ========================================================

    def emergency_stop(self):

        self.running = False

        self.stop_event.set()

        if self.recording:

            self.stop_recording()

        self.status_label.config(
            text="● EMERGENCY STOP",
            fg="#ff5969"
        )

        self.write_log(
            "Emergency stop activated."
        )

    # ========================================================
    # RECOVERY
    # ========================================================

    def recovery_mode(self):

        self.running = False

        if self.recording:

            self.stop_recording()

        self.status_label.config(
            text="● RECOVERY",
            fg="#ffc85a"
        )

        self.write_log(
            "Capture safely stopped."
        )

    # ========================================================
    # DASHBOARD
    # ========================================================

    def update_dashboard(self):

        try:

            self.cpu_usage = (
                psutil.cpu_percent(
                    interval=None
                )
            )

            self.ram_usage = (
                psutil.virtual_memory()
                .percent
            )

        except Exception:

            self.cpu_usage = 0
            self.ram_usage = 0

        self.fps_history.append(
            self.fps
        )

        self.cpu_history.append(
            self.cpu_usage
        )

        self.ram_history.append(
            self.ram_usage
        )

        self.fps_history = (
            self.fps_history[-100:]
        )

        self.cpu_history = (
            self.cpu_history[-100:]
        )

        self.ram_history = (
            self.ram_history[-100:]
        )

        health = "GOOD"

        if (
            self.cpu_usage >= 90
            or self.ram_usage >= 90
            or self.fps < 15
        ):

            health = "WARNING"

        if self.safe_mode_var.get():

            health = "SAFE"

        values = {

            "fps":
                f"{self.fps:.1f}",

            "frame":
                f"{self.frame_time:.1f} ms",

            "cpu":
                f"{self.cpu_usage:.0f}%",

            "ram":
                f"{self.ram_usage:.0f}%",

            "drop":
                str(
                    self.dropped_frames
                ),

            "resolution":
                self.get_resolution(),

            "effect":
                self.effect_var.get(),

            "recursion":
                str(
                    self.recursion_var.get()
                ),

            "session":
                self.format_time(
                    time.time()
                    - self.session_start
                ),

            "health":
                health
        }

        for key, value in values.items():

            if key in self.metric_labels:

                self.metric_labels[
                    key
                ].config(
                    text=value
                )

        self.root.after(
            500,
            self.update_dashboard
        )

    # ========================================================
    # PREVIEW
    # ========================================================

    def update_preview(self):

        if self.running:

            with self.frame_lock:

                frame = (
                    None
                    if self.current_frame is None
                    else self.current_frame.copy()
                )

            if frame is not None:

                try:

                    rgb = cv2.cvtColor(
                        frame,
                        cv2.COLOR_BGR2RGB
                    )

                    height, width = (
                        rgb.shape[:2]
                    )

                    available_width = max(
                        400,
                        self.preview.winfo_width()
                        - 20
                    )

                    available_height = max(
                        250,
                        self.preview.winfo_height()
                        - 20
                    )

                    scale = min(
                        available_width / width,
                        available_height / height,
                        1.0
                    )

                    if scale < 1:

                        rgb = cv2.resize(
                            rgb,
                            (
                                int(
                                    width
                                    * scale
                                ),
                                int(
                                    height
                                    * scale
                                )
                            ),
                            interpolation=cv2.INTER_AREA
                        )

                    image = Image.fromarray(
                        rgb
                    )

                    self.preview_image = (
                        ImageTk.PhotoImage(
                            image
                        )
                    )

                    self.preview.config(
                        image=self.preview_image,
                        text=""
                    )

                except Exception as error:

                    self.write_log(
                        f"Preview error: {error}"
                    )

        self.root.after(
            30,
            self.update_preview
        )

    # ========================================================
    # RESOLUTION
    # ========================================================

    def get_resolution(self):

        with self.frame_lock:

            frame = self.current_frame

        if frame is None:

            return "--"

        return (
            f"{frame.shape[1]}x"
            f"{frame.shape[0]}"
        )

    # ========================================================
    # REPORT
    # ========================================================

    def save_report(self):

        average_fps = (
            float(
                np.mean(
                    self.fps_history
                )
            )
            if self.fps_history
            else 0
        )

        average_cpu = (
            float(
                np.mean(
                    self.cpu_history
                )
            )
            if self.cpu_history
            else 0
        )

        average_ram = (
            float(
                np.mean(
                    self.ram_history
                )
            )
            if self.ram_history
            else 0
        )

        report = {

            "application":
                APP_NAME,

            "created":
                datetime.now().isoformat(),

            "session_time":
                self.format_time(
                    time.time()
                    - self.session_start
                ),

            "average_fps":
                round(
                    average_fps,
                    2
                ),

            "average_cpu":
                round(
                    average_cpu,
                    2
                ),

            "average_ram":
                round(
                    average_ram,
                    2
                ),

            "dropped_frames":
                self.dropped_frames,

            "total_frames":
                self.frame_counter,

            "effect":
                self.effect_var.get(),

            "recursion":
                self.recursion_var.get(),

            "mode":
                self.mode_var.get(),

            "resolution":
                self.get_resolution()
        }

        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        path = (
            REPORT_DIR
            / f"Report_{timestamp}.json"
        )

        try:

            path.write_text(
                json.dumps(
                    report,
                    indent=4
                ),
                encoding="utf-8"
            )

            self.write_log(
                f"Report saved: {path.name}"
            )

        except Exception as error:

            self.write_log(
                f"Report error: {error}"
            )

    # ========================================================
    # OPEN DATA FOLDER
    # ========================================================

    def open_data_folder(self):

        try:

            os.startfile(
                str(DATA_DIR)
            )

        except Exception as error:

            self.write_log(
                f"Folder error: {error}"
            )

    # ========================================================
    # LOG
    # ========================================================

    def write_log(self, message):

        timestamp = datetime.now().strftime(
            "%H:%M:%S"
        )

        def update():

            try:

                self.log_box.insert(
                    "end",
                    f"[{timestamp}] {message}\n"
                )

                self.log_box.see(
                    "end"
                )

            except Exception:

                pass

        try:

            self.root.after(
                0,
                update
            )

        except Exception:

            pass

    # ========================================================
    # FORMAT TIME
    # ========================================================

    def format_time(
        self,
        seconds
    ):

        seconds = int(
            max(
                0,
                seconds
            )
        )

        hours = (
            seconds // 3600
        )

        minutes = (
            seconds % 3600
        ) // 60

        seconds = (
            seconds % 60
        )

        return (
            f"{hours:02d}:"
            f"{minutes:02d}:"
            f"{seconds:02d}"
        )

    # ========================================================
    # CLOSE
    # ========================================================

    def close_application(self):

        self.running = False

        self.stop_event.set()

        if self.recording:

            self.stop_recording()

        self.root.destroy()


# ============================================================
# MAIN
# ============================================================

def main():

    root = tk.Tk()

    app = DesktopDoppelganger(
        root
    )

    root.mainloop()


if __name__ == "__main__":

    main()
